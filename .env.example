APP_NAME="Youth Policy Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://youthpolicytracker.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Production Database (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=youth_policy_tracker
DB_USERNAME=ypt_user
DB_PASSWORD=your_secure_password

# Session & Security Settings
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Reverse Proxy Trust
# Specify the exact IP addresses or CIDR blocks of your reverse proxy or load balancer.
# Local Nginx reverse proxy:  "127.0.0.1,::1"
# AWS / GCP private VPC:      "10.0.0.0/16"
# Cloudflare proxy IP ranges: "173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22"
TRUSTED_PROXIES="127.0.0.1,::1"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ypt_cache

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="secretariat@glowingminds.org.ng"
MAIL_FROM_NAME="${APP_NAME}"

# Analytics (Google Analytics 4 - loaded strictly after cookie consent)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
